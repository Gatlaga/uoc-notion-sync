# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role key — NEVER expose this in the frontend/browser

# Notion (notion.so/my-integrations -> your integration -> Secrets)
NOTION_TOKEN=secret_xxx

# Random long string you generate yourself — protects the /api/sync-worker cron endpoint
CRON_SECRET=change-me-to-a-random-string
